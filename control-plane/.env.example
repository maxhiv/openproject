# Rails
RAILS_ENV=development
PORT=5000
SECRET_KEY_BASE=generate-with-rails-secret
ALLOWED_HOSTS=yourdomain.com,your-service.run.app

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/control_plane_dev
CONTROL_PLANE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/control_plane_dev

# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id

# OpenProject Integration
OPENPROJECT_URL=https://your-openproject-instance.example.com
OPENPROJECT_API_TOKEN=your-openproject-api-token
OPENPROJECT_WEBHOOK_SECRET=generate-a-random-secret

# Optional
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=5
