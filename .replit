modules = ["web", "bash", "nodejs-22", "ruby-4.0", "postgresql-16"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["pkg-config", "libxml2", "libxslt", "imagemagick", "shared-mime-info", "zlib", "openssl", "libyaml", "libffi", "cmake", "gcc"]

[userenv]

[userenv.shared]
RAILS_ENV = "development"
PORT = "5000"
HOST = "0.0.0.0"
SILENCE_SQL_LOGS = "true"
SECRET_KEY_BASE = "a_dev_secret_key_base_that_is_at_least_64_bytes_long_for_openproject_replit_setup_1234567890"
OPENPROJECT_DISABLE_DEV_ASSET_PROXY = "true"
OPENPROJECT_HTTPS = "true"
OPENPROJECT_HOST__NAME = "57065939-3285-44e6-93a5-7472eb560e62-00-1c5qqlnoeu125.janeway.replit.dev"
CONTROL_PLANE_DATABASE_URL = "postgresql://postgres:password@helium/control_plane_dev?sslmode=disable"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Control Plane"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && bundle exec rails server -b 0.0.0.0 -p 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Control Plane"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/control-plane && CONTROL_PLANE_DATABASE_URL=\"postgresql://postgres:password@helium/control_plane_dev?sslmode=disable\" bundle exec rails server -b 0.0.0.0 -p 3000"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3000
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "cd /home/runner/workspace && bundle exec rails server -b 0.0.0.0 -p 5000 -e production"]
build = ["bash", "-c", "cd /home/runner/workspace/frontend && npm install && npm run build && cd /home/runner/workspace && bundle exec rails runner 'OpenProject::Assets.rebuild_manifest!'"]
